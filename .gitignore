# Crawler temporary files
services/crawler/temp/
services/crawler/cache/

# AI service models (if downloading)
services/ai-service/models/
services/ai-service/downloads/

# Frontend build artifacts
frontend/.next/
frontend/out/

# ============================================
# Keep important files
# ============================================
!.gitignore
!.dockerignore
!README.md
!*.md
!docker-compose.yml
!docker-compose.dev.yml
!**/.env.example
