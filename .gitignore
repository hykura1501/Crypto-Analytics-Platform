# ============================================
# Crypto Analytics Platform - .gitignore
# ============================================

# ============================================
# Go (Backend)
# ============================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Go build output
backend/main
backend/**/main
backend/**/*.exe
backend/**/*.dll
backend/**/*.so
backend/**/*.dylib

# Go vendor (if using)
vendor/

# ============================================
# Python (Services: crawler, ai-service)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
services/**/venv/
services/**/env/
services/**/.venv/

# Python cache
*.pyc
*.pyo
*.pyd
.Python
*.so

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================
# Node.js (Frontend)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
*.local
build/
.vite/

# Frontend specific
frontend/dist/
frontend/build/
frontend/.vite/
frontend/node_modules/

# Package managers (keep lock files for consistency)
# Uncomment if you want to ignore lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# Environment & Configuration
# ============================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Environment files in subdirectories
backend/.env
frontend/.env
services/**/.env

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# PostgreSQL dumps (keep migration files)
*.sql
*.dump
# Keep migration directories and files
!**/migrations/
!**/migrations/*.sql

# ============================================
# Docker
# ============================================
.dockerignore

# Docker volumes (if mounted locally)
docker-data/
postgres_data/
redis_data/

# Docker compose override files (may contain secrets)
docker-compose.override.yml
docker-compose.local.yml

# ============================================
# IDE & Editors
# ============================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/
.netrwhist

# Emacs
*~
\#*\#
.\#*
*~
*.elc
auto-save-list
tramp

