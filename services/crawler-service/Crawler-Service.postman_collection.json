{
	"info": {
		"_postman_id": "crawler-service-collection",
		"name": "Crawler Service",
		"description": "API collection for the Crypto Analytics Crawler Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"health"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Crawler",
			"item": [
				{
					"name": "Trigger Crawl Once",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/crawl/once",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"crawl",
								"once"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Sources",
			"item": [
				{
					"name": "List Sources",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/sources",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"sources"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Source",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/sources/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"sources",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "CoinDesk",
									"description": "Source ID"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Source",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"source_id\": \"NewSource\",\n    \"rss_url\": \"https://example.com/rss\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/sources",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"sources"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Source",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rss_url\": \"https://example.com/new-rss\",\n    \"title_tag\": \"h1.title\",\n    \"content_selector\": \"div.article-content\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/sources/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"sources",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "NewSource",
									"description": "Source ID"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Source",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/news/sources/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"news",
								"sources",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "NewSource",
									"description": "Source ID"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8083",
			"type": "string"
		}
	]
}
